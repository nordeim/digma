// Digma — collaborative design workspace
// Prisma schema (SQLite). Mirrors the domain model of the reference app:
// login users, design projects (with a template + canvas background),
// the design elements that live on a project canvas, teams and their members.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarColor  String   @default("#8B5CF6")
  // Session-43, RA-58: the reference's signup transitions to a verify-email
  // card before the session lands. The clone ports the flow with the
  // self-hosted delivery deviation (the 6-digit code travels in the API
  // response — no email service). Seeded/demo accounts stay pre-verified
  // (the @default(true) keeps every existing row and the seed untouched).
  verified       Boolean @default(true)
  verifyCode     String? // the pending 6-digit code (null once verified)
  verifyAttempts Int     @default(0) // wrong-code counter; 5 max, reset on resend
  // Session-46, RA-65: the reference's password-reset round-trip. Its
  // POST /auth/reset-password takes {reset_token, new_password} — an
  // invalid/expired token answers 400 "Invalid or expired reset token".
  // The token is email-only on the reference; the clone carries the
  // in-app delivery (the ADR-014 family — the resetUrl travels in the
  // forgot-password response). Single-use: cleared on a successful reset.
  resetToken           String?   // 64-hex crypto-random, null once consumed
  resetTokenExpiresAt  DateTime? // the 60-minute window ("invalid or has expired")
  // Session 67 (S67-A — the fifteenth audit's M-1, the documented B-5):
  // the stateless session's revocation dimension. The token embeds the
  // holder's version and getSessionUser rejects a mismatch — a password
  // reset increments it, evicting every previously minted cookie (the
  // pre-fix reset left stolen/observed sessions valid for their full
  // 7-day TTL). The @default(0) keeps every existing row and the seed
  // untouched.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A design file. The reference app calls these "projects" — a named canvas
// with a background color, created from a template (Blank Canvas / Mobile
// App / Desktop App / Website), opened in the Editor at /editor?projectId=.
model Project {
  id              String   @id @default(cuid())
  name            String
  description     String?
  template        String   @default("blank") // blank | mobile | desktop | website
  backgroundColor String   @default("#0D1117") // canvas background
  lastOpenedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  elements DesignElement[]
}

// One shape/text/image/frame on a project canvas. Coordinates are in canvas
// space (pixels at 100% zoom); the editor transforms them into viewport space.
model DesignElement {
  id          String   @id @default(cuid())
  projectId   String
  type        String // rectangle | ellipse | line | text | frame | image | path
  name        String?
  x           Float    @default(0)
  y           Float    @default(0)
  width       Float    @default(100)
  height      Float    @default(100)
  rotation    Float    @default(0)
  scale       Float    @default(1) // per-element visual scale (reference slider 0.1–3.0)
  opacity     Float    @default(1)
  fill        String? // hex/rgba — the Solid tab's color (RETAINED under a gradient; the gradient paints)
  fillGradient String? // JSON: { type: "linear"|"radial", angle: 0-360, stops: [{ color, position: 0-100 }] } — the Gradient tab (session 41, RA-54)
  fillImage   String? // data URL — the Image tab's uploaded fill (session 41, RA-54; wins over fillGradient)
  fillImageFit String? // "cover"|"contain"|"auto"|"stretch" — the Image tab's Background Size select (session 43, RA-61; stretch maps to "100% 100%" at the paint seam; null = cover)
  stroke      String?
  strokeWidth Float    @default(0)
  radius      Float    @default(0) // corner radius
  text        String? // text elements
  fontSize    Float?
  fontWeight  String? // 400 | 500 | 600 | 700
  fontFamily  String? // the reference's Font Family combobox (7 options, session 29)
  textAlign   String? // left | center | right
  // Session 70 (S70-B / L-A1 — the eighteenth audit): the four dead
  // columns dropped — thumbnailSeed (zero code references), src/path
  // (written by the row-builders, zero read sites), zIndex (written +
  // round-tripped through the DTO/store, zero read sites). The element
  // order lives on sortOrder + the array order of the replace contract.
  visible     Boolean  @default(true)
  locked      Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  // Session 70 (S70-B): the composite serves the filter+order every
  // element query actually runs (the old sortOrder-only index served no
  // query and amplified every 2000-row replace).
  @@index([projectId, sortOrder])
}

// Collaborator groups shown on the Teams page.
model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#8B5CF6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members TeamMember[]
}

// A human collaborator invited to a team (name + email + role).
model TeamMember {
  id         String   @id @default(cuid())
  teamId     String
  name       String
  email      String?
  role       String? // e.g. "Designer", "Developer", "Viewer"
  avatarColor String  @default("#3B82F6")
  createdAt  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}
