// Digma — collaborative design workspace
// Prisma schema (SQLite). Mirrors the domain model of the reference app:
// login users, design projects (with a template + canvas background),
// the design elements that live on a project canvas, teams and their members.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarColor  String   @default("#8B5CF6")
  // Session-43, RA-58: the reference's signup transitions to a verify-email
  // card before the session lands. The clone ports the flow with the
  // self-hosted delivery deviation (the 6-digit code travels in the API
  // response — no email service). Seeded/demo accounts stay pre-verified
  // (the @default(true) keeps every existing row and the seed untouched).
  verified       Boolean @default(true)
  verifyCode     String? // the pending 6-digit code (null once verified)
  verifyAttempts Int     @default(0) // wrong-code counter; 5 max, reset on resend
  // Session-46, RA-65: the reference's password-reset round-trip. Its
  // POST /auth/reset-password takes {reset_token, new_password} — an
  // invalid/expired token answers 400 "Invalid or expired reset token".
  // The token is email-only on the reference; the clone carries the
  // in-app delivery (the ADR-014 family — the resetUrl travels in the
  // forgot-password response). Single-use: cleared on a successful reset.
  resetToken           String?   // SHA-256 hex hash of the crypto-random token (S181-B hashed-at-rest), null once consumed
  resetTokenExpiresAt  DateTime? // the 60-minute window ("invalid or has expired")
  // Session 67 (S67-A — the fifteenth audit's M-1, the documented B-5):
  // the stateless session's revocation dimension. The token embeds the
  // holder's version and getSessionUser rejects a mismatch — a password
  // reset increments it, evicting every previously minted cookie (the
  // pre-fix reset left stolen/observed sessions valid for their full
  // 7-day TTL). The @default(0) keeps every existing row and the seed
  // untouched.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A design file. The reference app calls these "projects" — a named canvas
// with a background color, created from a template (Blank Canvas / Mobile
// App / Desktop App / Website), opened in the Editor at /editor?projectId=.
model Project {
  id              String   @id @default(cuid())
  name            String
  description     String?
  template        String   @default("blank") // blank | mobile | desktop | website
  backgroundColor String   @default("#0D1117") // canvas background
  // Session 112 (S112-C — the sixtieth audit's B92-I1 leg (a)): the
  // MAINTAINED per-project image-byte counter behind the elements
  // POST's cumulative fillImage bound (FILL_IMAGE_PROJECT_LIMIT_BYTES
  // in src/lib/editor.ts). The full-list PUT recomputes it from its
  // in-memory rows on every save, the duplicate route seeds it from
  // the source rows, and the elements POST increments it inside the
  // same transaction as the create — a create that never commits
  // never counts. Rows written before this column existed read 0
  // until their board's next PUT recomputes the truth (every suite
  // database starts fresh, and the seed itself seeds the counter
  // CENSUS-TRUE from its own rows since S118-D2 — the rowStoredBytes
  // sum, never the column default). Session 113 (S113-E / B-I4 —
  // the sixty-first audit): the LEGACY ZERO-COUNTER x POST
  // INTERSECTION, named — a pre-S112-C database upgraded in place
  // reads every counter 0, so a legacy image-heavy board accepts up
  // to the full 24 MB of NEW image bytes on top of its existing
  // payload before its first PUT recomputes the truth; the board then
  // rides the documented sticky wedge (validation.ts) with the
  // payloadDeadRef terminal + deletion recovery handling the client.
  // The counter measures the board's stored VARIABLE-field bytes
  // (fillImage + fillImageThumb since S114-A / B114-M1: the
  // sixty-second audit closed the thumb channel; PLUS the three
  // free-text fields text/name/fillGradient at their JSON-escaped
  // wire lengths since S117-A / B117-M1 — the sixty-fifth audit's
  // headline closed the non-fill channel: a per-REQUEST cap can
  // never stand in for this CUMULATIVE bound, and the census may not
  // stop at the image fields — the rowStoredBytes seam in
  // src/lib/editor.ts). The honest heaviest-image board's element
  // ceiling sits at ~31 (each ≤700K fill carries its ~10-50 KB thumb
  // and its own escaped name/gradient terms beside it). The 32 MB
  // body cap still bounds any single request.
  fillImageBytes   Int      @default(0)
  lastOpenedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  elements DesignElement[]
}

// One shape/text/image/frame on a project canvas. Coordinates are in canvas
// space (pixels at 100% zoom); the editor transforms them into viewport space.
model DesignElement {
  id          String   @id @default(cuid())
  projectId   String
  type        String // rectangle | ellipse | line | text | frame | image | path
  name        String?
  x           Float    @default(0)
  y           Float    @default(0)
  width       Float    @default(100)
  height      Float    @default(100)
  rotation    Float    @default(0)
  scale       Float    @default(1) // per-element visual scale (reference slider 0.1–3.0)
  opacity     Float    @default(1)
  fill        String? // hex/rgba — the Solid tab's color (RETAINED under a gradient; the gradient paints)
  fillGradient String? // JSON: { type: "linear"|"radial", angle: 0-360, stops: [{ color, position: 0-100 }] } — the Gradient tab (session 41, RA-54)
  fillImage   String? // data URL — the Image tab's uploaded fill (session 41, RA-54; wins over fillGradient)
  fillImageFit String? // "cover"|"contain"|"auto"|"stretch" — the Image tab's Background Size select (session 43, RA-61; stretch maps to "100% 100%" at the paint seam; null = cover)
  // Session 113 (S113-D — B92-I1 leg (b), the sixty-first audit's
  // deferred-queue front): the ~320px LIST-FAMILY re-encode of
  // fillImage, generated client-side at upload time (thumbnailFor in
  // properties-panel.tsx) and shipped in the fillImage slot by the
  // four list routes' withThumbFills projection (src/lib/editor.ts).
  // Null = no thumb (a legacy row pre-dating the codec, or a
  // best-effort encode failure) — the graceful fallback ships the
  // full image. The editor canvas and the detail GET read the FULL
  // fillImage; the thumb exists for the list projection's bandwidth
  // (a ~500 KB payload per image-bearing row becomes ~10-50 KB). The
  // duplicate route's ...rest copy carries it losslessly; the
  // elements PUT round-trips it through the client DTO (a PUT that
  // dropped it would wipe every thumb on save). Counted by
  // fillImageBytes alongside fillImage — the counter measures the
  // stored fill-family payload, both families summed at every bound
  // site (S114-A / B114-M1 closed the thumb channel the S113-D
  // codec opened; see the counter's comment above).
  fillImageThumb String?
  stroke      String?
  strokeWidth Float    @default(0)
  radius      Float    @default(0) // corner radius
  text        String? // text elements
  fontSize    Float?
  fontWeight  String? // 300 | 400 | 500 | 600 | 700 | 800 (the shared FONT_WEIGHTS enum — session 72, S72-D: the stale 4-value comment died)
  fontFamily  String? // the reference's Font Family combobox (7 options, session 29)
  textAlign   String? // left | center | right
  // Session 70 (S70-B / L-A1 — the eighteenth audit): the four dead
  // columns dropped — thumbnailSeed (zero code references), src/path
  // (written by the row-builders, zero read sites), zIndex (written +
  // round-tripped through the DTO/store, zero read sites). The element
  // order lives on sortOrder + the array order of the replace contract.
  visible     Boolean  @default(true)
  locked      Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Session 71 (S71-C / L-A6 — the nineteenth audit's B-F9): the
  // redundant single-column projectId index is dropped — the composite's
  // leftmost prefix serves every projectId-filtered query the app runs,
  // so the redundant sibling served NO query while adding write
  // amplification to every 2000-row replace (the exact family S70-B
  // set out to remove; the survivor was the S70-B swap's residue).
  @@index([projectId, sortOrder])
}

// Collaborator groups shown on the Teams page.
model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#8B5CF6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members TeamMember[]
}

// A human collaborator invited to a team (name + email + role).
model TeamMember {
  id         String   @id @default(cuid())
  teamId     String
  name       String
  email      String?
  role       String? // e.g. "Designer", "Developer", "Viewer"
  avatarColor String  @default("#3B82F6")
  createdAt  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // Session 127 (S127-D / B127-I1 — the seventy-fifth audit's
  // Informational): the redundant single-column @@index([teamId]) is
  // GONE — the S111-D compound uniqueness below carries teamId as its
  // leftmost prefix, so every teamId-only query rides the unique
  // index and the single-column copy served none while adding write
  // amplification to every member write (the S71-C redundant-index
  // doctrine's missed sibling).
  // Session 111 (S111-D / B-I3 — the fifty-ninth audit, the reference
  // gate LIFTED): the compound uniqueness — a (teamId, email) pair
  // commits exactly once. The 87th reference audit measured the
  // reference app carrying ZERO teams with dead Create-Team chrome and
  // no reachable invite flow, so no reference behavior exists to
  // mirror; this is the clone's working superset (the mobile-nav /
  // eye-toggle family precedent). SQLite unique indexes treat NULLs
  // as distinct, so the nullable email stays multi-insertable (the
  // API always writes a non-empty normalized value — the
  // normalizeEmail seam; a bare-trim read would leave the BINARY
  // collation bypassable by case variation).
  @@unique([teamId, email])
}
